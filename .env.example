# Open Pulse Checker full-stack runtime defaults
# Copy to .env and adjust values before production use.

# Runtime mode: auto | docker | local
OPENPULSE_RUNTIME_MODE=auto

# Backend
SPRING_PROFILES_ACTIVE=prod
OPENPULSE_PORT=8888

# Database (PostgreSQL is required)
OPENPULSE_DB_NAME=openpulse
OPENPULSE_DB_USERNAME=openpulse
# Replace before first real deployment
OPENPULSE_DB_PASSWORD=change-me-local-dev
OPENPULSE_DB_PORT=5432
OPENPULSE_DB_URL=jdbc:postgresql://localhost:5432/openpulse

# Frontend
OPENPULSE_FRONTEND_PORT=5173
# Build-time API URL consumed by frontend assets in Docker build.
# Must point to backend host port (not relative path), otherwise login/API calls fail from UI.
OPENPULSE_FRONTEND_API_BASE_URL=http://localhost:8888/api/v1
VITE_API_BASE_URL=http://localhost:8888/api/v1

# Optional one-time bootstrap admin (disabled by default)
OPENPULSE_SECURITY_BOOTSTRAP_ADMIN_ENABLED=false
OPENPULSE_SECURITY_BOOTSTRAP_ADMIN_USERNAME=admin
OPENPULSE_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
